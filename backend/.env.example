# Technoknowledge Backend Environment Configuration
# Copy this file to backend/.env and update values as needed.

APP_ENV=production
APP_URL=https://thetechnoknowledge.com

# Database Driver: 'sqlite' or 'mysql'
# 'sqlite' requires zero configuration.
# 'mysql' connects to your XAMPP or Hostinger MySQL database.
DB_DRIVER=sqlite

# MySQL Settings (used if DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=technoknowledge
DB_USER=root
DB_PASS=

# Lead Notification Email
NOTIFY_EMAIL=technoknowledge19@gmail.com
MAIL_FROM=website@thetechnoknowledge.com

# Optional SMTP Settings (leave empty to use default PHP mail())
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Security & Anti-Spam
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=600
MIN_FILL_MS=2500
