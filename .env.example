# Site
SITE_NAME=Technoknowledge
SITE_URL=https://thetechnoknowledge.com
API_BASE_URL=https://thetechnoknowledge.com/api

# Analytics (public IDs, safe for the front end)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
