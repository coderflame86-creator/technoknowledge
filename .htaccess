# =========================================================
# Technoknowledge: Root Server Settings & SEO Clean URLs
# Apache / LiteSpeed configuration for Hostinger & Local XAMPP
# =========================================================

Options -Indexes
DirectoryIndex frontend/index.html index.php index.html

# Missing pages show our friendly 404 page (real 404 status)
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------
# 1. LIVE DOMAIN CANONICAL (https and no www for live site)
# ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.thetechnoknowledge\.com$ [NC]
RewriteRule ^ https://thetechnoknowledge.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^thetechnoknowledge\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://thetechnoknowledge.com%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------
# 2. BACKEND PASSTHROUGH (Admin portal, APIs, assets)
# ---------------------------------------------------------
RewriteRule ^backend(/.*)?$ - [L]

# ---------------------------------------------------------
# 3. STATIC ASSETS & SYSTEM FILES -> FRONTEND/
# ---------------------------------------------------------
RewriteRule ^(assets|css|js)/(.*)$ frontend/$1/$2 [L,QSA]
RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|404\.html)$ frontend/$1 [L]

# ---------------------------------------------------------
# 4. REMOVE DIRECT /frontend/ OR /pages/ OR .html ACCESS (301)
# ---------------------------------------------------------
# Only redirect initial external requests, never internal rewrites
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^frontend/index\.html$ / [R=301,L,NC]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^frontend/?$ / [R=301,L,NC]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.html$ / [R=301,L,NC]

# Redirect direct /pages/ or /frontend/pages/ for blog articles -> /blog/<slug>
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(?:frontend/)?pages/blog/([^/]+?)(?:\.html)?$ /blog/$1 [R=301,L,NC]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(?:frontend/)?pages/blog/?$ /blog [R=301,L,NC]

# Redirect direct /pages/<page> or /frontend/pages/<page> -> /<page>
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(?:frontend/)?pages/([^/]+?)(?:\.html)?$ /$1 [R=301,L,NC]

# Strip .html from direct requests (e.g. /about.html -> /about, /blog/post.html -> /blog/post)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/backend
RewriteRule ^blog/([^/]+?)\.html$ /blog/$1 [R=301,L,NC]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/backend
RewriteRule ^([^/]+?)\.html$ /$1 [R=301,L,NC]

# Strip trailing slash from clean page URLs (e.g. /about/ -> /about)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# ---------------------------------------------------------
# 5. OLD WORDPRESS REDIRECTS -> NEW CLEAN SEO URLs (301)
# ---------------------------------------------------------
RewriteRule ^home/?$ / [R=301,L,NC]
RewriteRule ^about-us/?$ /about [R=301,L,NC]
RewriteRule ^contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^coding-camps-for-kids/?$ /techno-camps [R=301,L,NC]
RewriteRule ^school-bootcamps/?$ /techno-camps [R=301,L,NC]
RewriteRule ^robotics-camp/?$ /techno-camps [R=301,L,NC]
RewriteRule ^registration/?$ /techno-camps [R=301,L,NC]
RewriteRule ^early-age-curriculum/?$ /itec-curriculum [R=301,L,NC]
RewriteRule ^digitized-curriculum/?$ /itec-curriculum [R=301,L,NC]
RewriteRule ^teacher-training/?$ /itec-curriculum [R=301,L,NC]
RewriteRule ^train-the-trainer/?$ /itec-curriculum [R=301,L,NC]
RewriteRule ^facilitate-lab-set-up/?$ /itec-curriculum [R=301,L,NC]
RewriteRule ^aitep-ai-training-for-teachers/?$ /aitep [R=301,L,NC]
RewriteRule ^robotics-iot-for-schools/?$ /robotics-iot [R=301,L,NC]
RewriteRule ^robotics/?$ /robotics-iot [R=301,L,NC]
RewriteRule ^teacher-training-2/?$ /monitoring-evaluation [R=301,L,NC]
RewriteRule ^monitoring-and-evaluation/?$ /monitoring-evaluation [R=301,L,NC]
RewriteRule ^projects-and-collaborations/?$ /impact [R=301,L,NC]
RewriteRule ^school-registration/?$ /request-proposal [R=301,L,NC]
RewriteRule ^request-a-proposal/?$ /request-proposal [R=301,L,NC]
RewriteRule ^school-programs/?$ / [R=301,L,NC]
RewriteRule ^services/?$ / [R=301,L,NC]
RewriteRule ^for-schools/?$ / [R=301,L,NC]

# WordPress blog post redirects -> clean blog SEO URLs
RewriteRule ^jobs-of-the-next-decade-in-the-era-of-ai/?$ /blog/jobs-of-the-next-decade-in-the-era-of-ai [R=301,L,NC]
RewriteRule ^teach-coding-to-kids/?$ /blog/teach-coding-to-kids [R=301,L,NC]
RewriteRule ^coding-from-zero-level/?$ /blog/coding-from-zero-level [R=301,L,NC]
RewriteRule ^how-to-make-a-game-without-coding/?$ /blog/how-to-make-a-game-without-coding [R=301,L,NC]
RewriteRule ^coding-and-programming/?$ /blog/coding-and-programming [R=301,L,NC]
RewriteRule ^how-to-start-coding-for-kids/?$ /blog/how-to-start-coding-for-kids [R=301,L,NC]
RewriteRule ^how-to-do-coding-in-a-laptop-for-kids/?$ /blog/how-to-do-coding-in-a-laptop-for-kids [R=301,L,NC]
RewriteRule ^coding-apps-for-kids/?$ /blog/coding-apps-for-kids [R=301,L,NC]
RewriteRule ^10-html-css-projects-for-beginners/?$ /blog/10-html-css-projects-for-beginners [R=301,L,NC]
RewriteRule ^graphic-design-for-kids/?$ /blog/graphic-design-for-kids [R=301,L,NC]
RewriteRule ^games-to-learn-python/?$ /blog/games-to-learn-python [R=301,L,NC]
RewriteRule ^computer-science-for-kids/?$ /blog/computer-science-for-kids [R=301,L,NC]
RewriteRule ^best-games-of-scratch-for-kids/?$ /blog/best-games-of-scratch-for-kids [R=301,L,NC]
RewriteRule ^coding-bootcamp-for-kids/?$ /blog/coding-bootcamp-for-kids [R=301,L,NC]
RewriteRule ^why-coding-is-good-investment-for-child/?$ /blog/why-coding-is-good-investment-for-child [R=301,L,NC]
RewriteRule ^10-designer-buys-that-are-worth-the-investment/?$ /blog/block-programming-for-kids [R=301,L,NC]
RewriteRule ^our-pick-of-the-coolest-denim-jackets-this-season/?$ /blog/block-programming-tools [R=301,L,NC]
RewriteRule ^jay-ellis-proves-one-suit-can-work-four-different-ways/?$ /blog/teaching-programming-early-years [R=301,L,NC]

# WordPress sitemaps
RewriteRule ^(wp-sitemap.*|sitemap_index|page-sitemap|post-sitemap|category-sitemap)\.xml$ /sitemap.xml [R=301,L,NC]

# WordPress query strings (?p=123 etc) -> /
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|s)=
RewriteRule ^$ /? [R=301,L]

# WordPress system addresses: tell Google gone (410)
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json|wp-login\.php|xmlrpc\.php)(/.*)?$ - [G,L]
RewriteRule ^(feed|comments/feed|cart|checkout|my-account|shop|product|product-category|product-tag|author|category|tag|page)(/.*)?$ - [G,L]
RewriteRule ^.+/feed/?$ - [G,L]

# ---------------------------------------------------------
# 6. INTERNAL CLEAN URL ROUTING (URL stays clean in browser)
# ---------------------------------------------------------
# Root -> frontend/index.html
RewriteRule ^$ frontend/index.html [END]

# Blog root: /blog or /blog/ -> frontend/pages/blog.html
RewriteRule ^blog/?$ frontend/pages/blog.html [END,NC]

# Blog articles: /blog/<slug> -> frontend/pages/blog/<slug>.html
RewriteRule ^blog/([^/]+)/?$ frontend/pages/blog/$1.html [END,NC]

# Known main pages -> frontend/pages/<page>.html
RewriteRule ^(about|aitep|books|contact|impact|itec-curriculum|lms|monitoring-evaluation|privacy-policy|request-proposal|robotics-iot|techno-camps)/?$ frontend/pages/$1.html [END,NC]
RewriteRule ^style-guide/?$ frontend/style-guide.html [END,NC]

# Generic fallback for any other .html page inside frontend/pages/
RewriteCond %{DOCUMENT_ROOT}/frontend/pages/$1.html -f
RewriteRule ^([^/]+)/?$ frontend/pages/$1.html [END]

</IfModule>

# ---------- speed: compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# ---------- speed: browser caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Deny access to sensitive files
<FilesMatch "(^\.|\.(env|git|sqlite|db|log|ini|json|sql|py|mjs|sh|md)$)">
  Require all denied
</FilesMatch>
